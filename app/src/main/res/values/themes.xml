<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VaultlyMobile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.VaultlyMobile" parent="Base.Theme.VaultlyMobile">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>

    <style name="Theme.VaultlyMobile.NoActionBar">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="NormalButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_width">350dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="outlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_width">350dp</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/white_transparent</item>
    </style>

    <style name="solidButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_width">350dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>

</resources>
